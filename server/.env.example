PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/support-agent
JWT_SECRET=change-this-to-a-long-random-string

# Dashboard login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Origins allowed to call /api/admin (your dashboard URL). Comma-separated.
DASHBOARD_ORIGIN=http://localhost:5173

# LLM for chat + tool calling (Groq). Groq retires models often: check console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings for RAG (Google Gemini, free tier). Leave empty to use keyword search instead.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# Store details the agent uses in replies
STORE_NAME=Hannes & Co.
SUPPORT_EMAIL=support@hannes-demo.example

# Tuning (see README: "Tuning confidence")
CONFIDENCE_THRESHOLD=0.6
RELEVANCE_LOW=0.55
RELEVANCE_HIGH=0.75
TOP_K=4
